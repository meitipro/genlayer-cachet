# The network everything reads and writes against: studionet | bradbury
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# The deployed Cachet. EMPTY ON PURPOSE: until this is set, every screen that
# would otherwise show a round says so instead, and nothing is invented to fill
# the gap. Copy the address EXACTLY as `npm run deploy` prints it -- Studio
# matches the string literally, and the all-lowercase form of a real contract
# answers "Contract not found", which the site then reports as "could not read
# the chain" on a contract that is running perfectly.
#
# Addresses are PER NETWORK. Changing the network above without deploying again
# points the site at an address that does not exist there.
NEXT_PUBLIC_CACHET_ADDRESS=

# This site's own origin, for permalinks, the sitemap and link previews.
#
# In production this is https://cachets.xyz -- set it there and nowhere else.
# Leave it EMPTY locally: it falls back to http://localhost:4100 on a dev
# server, and to Vercel's own deployment URL before a domain is attached.
#
# Getting this wrong is quiet rather than loud. The site works perfectly on the
# new domain with a stale origin; what breaks is everything that names itself
# -- sitemap.xml, robots.txt, canonical tags, and every link preview.
NEXT_PUBLIC_ORIGIN=

# NOT one to add: Vercel injects NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL
# itself, and ORIGIN falls back to it when the variable above is empty. Setting
# it by hand only gets it wrong.

# OPTIONAL. Overrides the block explorer the site links transactions and
# addresses to. Leave it empty unless you have a reason: Studio defaults to
# explorer-studio.genlayer.com, and Bradbury takes the url the SDK ships.
#
# The default is hardcoded for Studio on purpose - genlayer-js points studionet
# at genlayer-explorer.vercel.app, which answers 503 on every request. Set this
# only if you are running your own explorer. An empty value is fine and simply
# removes the explorer links rather than producing dead ones.
NEXT_PUBLIC_GENLAYER_EXPLORER=

# Only for the scripts (npm run deploy / seed / injection / bidder / settle /
# status). The website never reads this and never holds a key: every write from
# a browser is signed in the reader's own wallet.
#
# Generate one locally and fund it with `npm run deploy -- --fund`, which calls
# Studio's programmatic faucet. Never reuse a key that holds anything.
CACHET_DEPLOYER_KEY=
