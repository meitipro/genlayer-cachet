# The network everything reads and writes against: studionet | bradbury
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# The deployed Cachet. EMPTY ON PURPOSE: until this is set, every screen that
# would otherwise show a round says so instead, and nothing is invented to fill
# the gap. Copy the address EXACTLY as `npm run deploy` prints it -- Studio
# matches the string literally, and the all-lowercase form of a real contract
# answers "Contract not found", which the site then reports as "could not read
# the chain" on a contract that is running perfectly.
#
# Addresses are PER NETWORK. Changing the network above without deploying again
# points the site at an address that does not exist there.
NEXT_PUBLIC_CACHET_ADDRESS=

# This site's own origin, for permalinks, the sitemap and link previews.
# Leave it empty locally: it falls back to Vercel's own URL in a deployment,
# and to http://localhost:4100 on a dev server.
NEXT_PUBLIC_ORIGIN=

# Only for the scripts (npm run deploy / seed / injection / bidder / settle /
# status). The website never reads this and never holds a key: every write from
# a browser is signed in the reader's own wallet.
#
# Generate one locally and fund it with `npm run deploy -- --fund`, which calls
# Studio's programmatic faucet. Never reuse a key that holds anything.
CACHET_DEPLOYER_KEY=
