# dependencies and build output
node_modules/
.next/
out/
build/
*.tsbuildinfo

# secrets. CACHET_DEPLOYER_KEY is a real private key: it is generated locally,
# read from the environment by the scripts, and must never be committed.
.env
.env.*
!.env.example
*.key
*.pem

# resumable run state. Holds the bidder keys and salts for a seeded round, so
# it is both machine-specific and sensitive.
scripts/.seed-state.json

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/

# python bytecode
__pycache__/
*.py[cod]

# ---------------------------------------------------------------- not public
#
# The repository shows the work. It is not a deployment kit and not a press
# folder, so everything below stays local.

# Production material. Video prompts, the teaser script and the launch copy are
# working material for one launch, not part of the project.
production/

# Runbooks and internal notes. These carry the deployment sequence, the
# environment variables, the domain setup and the submission write-up. A reader
# of this repository wants the contract and the site, not the operator's
# checklist.
DEPLOY.md
SUBMISSION.md

# Editor and assistant config, and dev-server launch profiles
.claude/
